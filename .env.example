# Copy this file to .env.local and fill in your own values.
# Create a free project at https://www.sanity.io/manage to get a project ID.

# Sanity project (required)
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production

# Token with "Viewer" permission (Sanity manage > API > Tokens). Used for live content updates and draft preview.
SANITY_API_READ_TOKEN=

# Token with "Editor" permission. Server-side only: saves contact form messages and runs `npm run seed`.
# Never expose it to the browser and never commit it.
SANITY_API_WRITE_TOKEN=

# Your public site URL (used for sitemap, robots.txt and metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
